@model IReadOnlyList<HVACManagement.Models.Domain.Project>
@{
    ViewData["Title"] = "Projects";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Projects</h2>
    <a asp-action="Create" class="btn btn-primary">Create Project</a>
</div>
<table class="table table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Budget</th><th>Progress</th><th>Deadline</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProjectCode</td>
            <td>@p.ProjectName</td>
            <td>@p.Status</td>
            <td>@p.Budget.ToString("C")</td>
            <td>@p.ProgressPercentage%</td>
            <td>@p.DeadlineDate.ToString("yyyy-MM-dd")</td>
        </tr>
    }
    </tbody>
</table>
